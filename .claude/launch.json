{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "erp-prueba",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "backend/src/server.ts"
      ],
      "env": {
        "PORT": "3002",
        "DATABASE_URL": "file:./prueba-agente.db",
        "BACKUP_AUTO": "false",
        "N8N_WEBHOOK_ENVIO": ""
      },
      "port": 3002
    }
  ]
}
