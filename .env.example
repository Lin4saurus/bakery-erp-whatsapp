# Ruta relativa a database/prisma/schema.prisma
DATABASE_URL="file:./dulzura.db"
# Respaldos: carpeta (relativa a la raíz o absoluta, ej. la de Google Drive para escritorio)
# BACKUP_DIR="G:/Mi unidad/Dulzura/respaldos"
# BACKUP_KEEP=30
# BACKUP_AUTO=false   # desactiva el respaldo automático al iniciar la API
# Dónde escucha la API: 127.0.0.1 = solo esta PC (por defecto). 0.0.0.0 la abre a la red del local (sin clave: no recomendado).
# HOST="127.0.0.1"
