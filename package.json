  "private": true,
  "description": "ERP local para la reposterÃƒÆ’Ã‚Â­a Dulzura",
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "tsx database/prisma/seed.ts"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:check": "tsx database/prisma/check-seed.ts",
    "db:historico": "tsx database/prisma/importar-historico.ts",
    "backup": "tsx backend/src/backup.ts",
    "pin": "tsx backend/src/pin.ts",
    "paquete": "tsx instalacion/armar-paquete.ts",
